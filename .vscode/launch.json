{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Project Memory API Debug",
      "runtimeExecutable": "${workspaceFolder}/backend/node_modules/.bin/ts-node-dev",
      "args": ["--respawn", "--transpile-only", "src/server.ts"],
      "cwd": "${workspaceFolder}/backend",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}